# Server
PORT=5000
NODE_ENV=development

# Database — local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/my_life_dashboard

# Auth — use a long random value, e.g. `openssl rand -hex 48`
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Optional: run with a temporary in-memory MongoDB (great for a quick preview).
# When true, MONGODB_URI is ignored. Data disappears when the server stops.
USE_MEMORY_DB=false

# Optional: seed demo data automatically on boot (used by `npm run dev:memory`)
AUTO_SEED=false
